{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/download-pdf.ts": {
      "includeFiles": "files/vida-en-orden.pdf"
    },
    "api/send-pdf.ts": {
      "includeFiles": "files/vida-en-orden.pdf"
    }
  },
  "rewrites": [
    {
      "source": "/gracias",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}